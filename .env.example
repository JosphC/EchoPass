# LAN IP of this machine so a physical phone can reach Metro and mock-api.
# Replace with your IPv4 address (ipconfig / ifconfig). Never commit real secrets.
REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.10

# Public API used by the phone. Must be reachable from the device, not "localhost".
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# false = repositories "real" talking to mock-api (Docker default)
# true  = in-memory mocks (Jest / local UI without API)
EXPO_PUBLIC_USE_MOCKS=false

# true = live STPT Timisoara positions for buses (rest stays on mocks)
EXPO_PUBLIC_USE_REAL_BUS=false

# Google Maps Android key (empty = list fallback instead of the map)
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
